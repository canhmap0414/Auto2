{
  "name": "auto2",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright + TypeScript automation framework (POM, Allure)",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ci": "playwright test",
    "typecheck": "tsc --noEmit",
    "report:generate": "allure generate reports/allure-results -o reports/allure-report --clean",
    "report:single": "allure generate reports/allure-results -o reports/allure-report-single --single-file --clean",
    "report:open": "allure open reports/allure-report"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "allure-commandline": "^2.46.1",
    "allure-js-commons": "^3.14.0",
    "allure-playwright": "^3.14.0",
    "dotenv": "^18.0.9",
    "typescript": "^7.0.2",
    "winston": "^3.19.0"
  }
}
